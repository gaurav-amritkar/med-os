<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 3.2.5 shipped Tomcat 10.1.20, Spring Security 6.2.4, Jackson 2.15.4,
             Netty 4.1.109 and Micrometer 1.12.5, which carried 10 critical and 36
             high CVEs in the built image, all with published fixes. See #76. -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.medos</groupId>
    <artifactId>medos-backend</artifactId>
    <version>3.0.0</version>
    <name>medos-backend</name>
    <description>MedOS HMS v3.0 - Hospital Management System Backend</description>

    <properties>
        <java.version>17</java.version>
        <jjwt.version>0.12.5</jjwt.version>
        <!-- Pinned because the JDK this builds with is ahead of the version Spring
             Boot manages. Re-check on every Boot upgrade. -->
        <lombok.version>1.18.46</lombok.version>
        <!-- Patch-level overrides of Spring Boot's managed transitive versions.
             Each clears a finding the scanner reports against the version Boot
             ships, and is a patch bump within the same line Boot manages, so it
             stays inside what Boot is tested against. Verify with a scan before
             relaxing any of them, and remove them once Boot ships the fix
             natively. See #76. -->
        <netty.version>4.1.137.Final</netty.version>
        <!-- Overridden as a BOM, not per-artifact: jackson-annotations and
             jackson-databind version independently, so pinning only databind
             would risk a mismatch in the HTTP serialisation layer. -->
        <jackson-bom.version>2.21.6</jackson-bom.version>
        <postgresql.version>42.7.12</postgresql.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Transitive from the Redis starter. 4.1.135 ships a critical
             Netty handler flaw; the fix is a patch bump in the same line. -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
            <version>${netty.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.5.0</version>
        </dependency>

        <!-- Flyway owns the schema (see database/README.md); Hibernate only validates.
             Boot 3.5.16 manages Flyway 11, where PostgreSQL support moved out of
             flyway-core into its own module. Without this the application starts
             and then fails: "Unsupported Database: PostgreSQL 16.9". The 119
             backend tests do not catch it because they run on H2, so the running
             stack against PostgreSQL is the only place this shows up. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- 42.7.11 ships a SCRAM MITM bypass; 42.7.12 is a patch bump. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- os-maven-plugin supplies ${os.detected.classifier}, which appears in
             Netty's netty-tcnative coordinate. Without it the property is never
             substituted, and dependency resolution fails on Linux x86_64 with
             "Could not find artifact
             io.netty:netty-tcnative:jar:${os.detected.classifier}". It cannot
             reproduce on macOS or an arm64 Linux image, where the optional native
             module is never selected, so the broken coordinate is never reached. -->
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.1</version>
            </extension>
        </extensions>
        <!--
            database/migrations is the single owner of the Flyway migrations of the Flyway migrations
            (docs/adr/0005-migration-ownership.md). It lives outside this module
            so the dedicated migrate image and the application read the same
            file, and it is copied onto the classpath here rather than kept as a
            second hand-maintained copy that could drift.
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/../database/migrations</directory>
                <targetPath>db/migration</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <!-- JDK 23+ defaults to -proc:none; explicitly enable annotation processing so Lombok generates getters/setters/builders. -->
                    <proc>full</proc>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
