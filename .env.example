# Database
DB_PASSWORD=your_secure_database_password_here

# Redis
REDIS_PASSWORD=your_secure_redis_password_here

# JWT Secret (min 32 bytes base64)
JWT_SECRET=your_jwt_secret_min_32_bytes_base64_here

# PII Encryption Key (32 bytes base64)
PII_ENCRYPTION_KEY=your_pii_encryption_key_32_bytes_base64_here

# Bootstrap Admin Password (optional)
BOOTSTRAP_ADMIN_PASSWORD=your_bootstrap_admin_password_here

# Platform super-admin (optional). When set, a membership-less platform account is
# created at boot and can provision hospitals without the registration token.
# Generate with: openssl rand -base64 24
BOOTSTRAP_SUPERADMIN_USERNAME=platform
BOOTSTRAP_SUPERADMIN_PASSWORD=

# CORS Origins (comma-separated). For local development the app is served from
# the frontend container, so allow that origin. Add your real hostname for
# production; see .env.prod.example.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Frontend host port for local development.
# 8080 avoids needing a privileged port and avoids clashing with anything
# already on :80. The dev stack is not behind Caddy; :80 is production only.
FRONTEND_EXTERNAL_PORT=8080
VITE_API_URL=/api/v1

# Platform secret required by POST /api/v1/onboarding/register to provision a
# hospital. Leave blank to disable tenant provisioning entirely — the endpoint
# fails closed, it does not fall open. Generate with: openssl rand -base64 32
ONBOARDING_REGISTRATION_TOKEN=
