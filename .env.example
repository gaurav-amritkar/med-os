# MedOS HMS — environment configuration template
# Copy to `.env` and fill in real values. NEVER commit `.env` or real secrets.

# --- PostgreSQL ---
DB_NAME=medos
DB_USER=medos
DB_PASSWORD=change-me

# --- Redis ---
# Required for a production deployment. Leave empty only for local development.
REDIS_PASSWORD=

# --- JWT signing key (REQUIRED for production) ---
# Generate with: openssl rand -base64 48
# Must decode to at least 32 bytes. The app fails fast at startup if unset/weak.
JWT_SECRET=

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost,http://localhost:8080

# --- Initial admin account (production, one-time) ---
# If no admin user exists, the app creates 'admin' with this password on first boot.
# Generate with: openssl rand -base64 24   — then unset it after first login.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Frontend API base URL (baked in at build time, proxied through nginx) ---
VITE_API_URL=/api

# --- Public frontend port ---
FRONTEND_EXTERNAL_PORT=8080
