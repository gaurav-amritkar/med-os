# Database
DB_PASSWORD=your_secure_database_password_here

# Redis
REDIS_PASSWORD=your_secure_redis_password_here

# JWT Secret (min 32 bytes base64)
JWT_SECRET=your_jwt_secret_min_32_bytes_base64_here

# PII Encryption Key (32 bytes base64)
PII_ENCRYPTION_KEY=your_pii_encryption_key_32_bytes_base64_here

# Bootstrap Admin Password (optional)
BOOTSTRAP_ADMIN_PASSWORD=your_bootstrap_admin_password_here

# CORS Origins (comma-separated)
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Frontend
FRONTEND_EXTERNAL_PORT=80
VITE_API_URL=/api/v1