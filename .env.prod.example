# Production environment template for MedOS HMS.
#
# Copy to .env on the host, fill in, and keep it out of version control. This
# file contains NO secrets: credential values are read from the files under
# /run/secrets, populated per ADR-0004, and never from this file.
#
#   cp .env.prod.example .env
#
# Deployment descriptor: docker-compose.prod.yml
# Decision record:      docs/adr/0008-supabase-managed-postgres-auth-stays-inhouse.md

# --- Supabase (managed PostgreSQL) ------------------------------------------
# Use the POOLER connection string, not the direct database port, and keep
# sslmode=require. Patient records cross this connection.
#
# The pooler is not optional: Supabase direct hosts (db.<ref>.supabase.co)
# resolve to IPv6 only, so an IPv4-only host cannot reach them at all.
#
# The project must be created in the SPECIFIC region ap-south-1 (Mumbai). A
# general "Asia Pacific" region group may deploy outside India. A project's
# region is fixed at provisioning and cannot be changed afterwards.
#
# No password here on purpose. The password is delivered to both the migrate
# and backend containers as the db-password secret (secrets/db-password.txt),
# so putting it in this URL would copy the secret into a second file and into
# `docker compose config` output.
SUPABASE_POOLER_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Database role used by Flyway and the application.
#
# Through the pooler this MUST include the project ref as a suffix. Supavisor
# identifies the project from the username, so a bare "postgres" is rejected
# before authentication is even attempted:
#   FATAL: (ENOIDENTIFIER) no tenant identifier provided
#          (external_id or sni_hostname required)
DB_USER=postgres.PROJECT_REF

# Client-side pool size. Keep it modest: the pooler multiplexes connections, and
# a large client pool can exhaust the shared pooler's allowance.
DB_POOL_SIZE=10

# --- TLS ---------------------------------------------------------------------
# A real hostname with an A/AAAA record pointing at the host. Caddy obtains a
# publicly-trusted certificate over ACME; there is no self-signed fallback.
MEDOS_DOMAIN=hms.example.com

# Contact address for ACME expiry notices.
ACME_EMAIL=ops@example.com

# --- Image tag ---------------------------------------------------------------
# Pin this to an immutable tag or digest in production. "local" is for the
# development compose only.
MEDOS_TAG=local

# --- Secret files ------------------------------------------------------------
# Directory holding the credential files mounted at /run/secrets. Populate from
# the cloud secret manager, not from a checkout.
SECRETS_DIR=./secrets

# Required files in SECRETS_DIR:
#   db-password.txt                    the postgres role password
#   redis-password.txt                 Redis requirepass
#   jwt-secret.txt                     openssl rand -base64 48
#   pii-encryption-key.txt             openssl rand -base64 32   <-- see note below
#   cors-origins.txt                   https://<MEDOS_DOMAIN>
#
# NOTE on pii-encryption-key.txt: this is the KEY-ENCRYPTION KEY (KEK), not the
# key that encrypts patient data. It wraps a per-tenant DEK, so it IS rotatable
# online with no data migration — see docs/operations.md section 7d. What is not
# implemented is rotating an individual tenant's DEK, which would need a data
# migration. Store it in the secret manager and keep the previous version until
# verify has passed. See docs/adr/0009-envelope-encryption-per-tenant-deks.md.
#
# BOOTSTRAP_ADMIN_PASSWORD -- READ THIS BEFORE THE FIRST BOOT
#   The backend REQUIRES BOOTSTRAP_ADMIN_PASSWORD (application-prod.yml sets it
#   with no default). As committed, docker-compose.prod.yml neither passes the
#   variable nor mounts a secret for it, so THE PROD BACKEND WILL NOT START.
#   Create secrets/bootstrap-admin-password.txt (openssl rand -base64 18) AND
#   add `bootstrap-admin-password` to both the `secrets:` list and the
#   environment of the backend service in docker-compose.prod.yml.
#   After the first successful login, change the admin password and remove this
#   secret; the bootstrap runner is a no-op once an admin user exists.
#
# Also currently inert, worth knowing: ACME_EMAIL below is not passed to the
# caddy service by docker-compose.prod.yml, so Caddy falls back to its default
# contact address and expiry notices do not reach you. DB_POOL_SIZE likewise is
# not read (application-prod.yml hardcodes the pool size).
