# Production environment template for MedOS HMS.
#
# Copy to .env on the host, fill in, and keep it out of version control. This
# file contains NO secrets: credential values are read from the files under
# /run/secrets, populated per ADR-0004, and never from this file.
#
#   cp .env.prod.example .env
#
# Deployment descriptor: docker-compose.prod.yml
# Decision record:      docs/adr/0008-supabase-managed-postgres-auth-stays-inhouse.md

# --- Supabase (managed PostgreSQL) ------------------------------------------
# Use the POOLER connection string (port 6543), not the direct database port,
# and keep sslmode=require. Patient records cross this connection.
# The project must be created in the SPECIFIC region ap-south-1 (Mumbai). A
# general "Asia Pacific" region group may deploy outside India.
SUPABASE_POOLER_URL=jdbc:postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Database role used by Flyway and the application.
DB_USER=postgres

# Client-side pool size. Keep it modest: the pooler multiplexes connections, and
# a large client pool can exhaust the shared pooler's allowance.
DB_POOL_SIZE=10

# --- TLS ---------------------------------------------------------------------
# A real hostname with an A/AAAA record pointing at the host. Caddy obtains a
# publicly-trusted certificate over ACME; there is no self-signed fallback.
MEDOS_DOMAIN=hms.example.com

# Contact address for ACME expiry notices.
ACME_EMAIL=ops@example.com

# --- Image tag ---------------------------------------------------------------
# Pin this to an immutable tag or digest in production. "local" is for the
# development compose only.
MEDOS_TAG=local

# --- Secret files ------------------------------------------------------------
# Directory holding the credential files mounted at /run/secrets. Populate from
# the cloud secret manager, not from a checkout.
SECRETS_DIR=./secrets

# Required files in SECRETS_DIR:
#   db-password.txt          the postgres role password
#   redis-password.txt       Redis requirepass
#   jwt-secret.txt           openssl rand -base64 48
#   pii-encryption-key.txt   openssl rand -base64 32   <-- see the warning below
#   cors-origins.txt         https://<MEDOS_DOMAIN>
#
# WARNING on pii-encryption-key.txt: it encrypts patient names and clinical
# notes. There is no key-rotation path in the codebase yet, so this value cannot
# be changed after patient data exists without re-encrypting every ciphertext
# first. Generate it once, store it in the secret manager, and do not rotate it
# casually. See issue #73 and docs/adr/0004-secret-management.md.
#
# After the first successful boot, change the bootstrap admin password and
# clear BOOTSTRAP_ADMIN_PASSWORD from the secret manager. It is only read when
# no admin user exists.
